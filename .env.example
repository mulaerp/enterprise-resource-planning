# =============================================================================
# REQUIRED — compose.yaml supplies no fallback for these three (deployment hardening: a careless
# deploy with no .env used to silently ship known example creds). `docker compose` fails fast
# with a clear message if any is unset. Copy this file to `.env` (compose auto-loads it) and set
# real values before running `docker compose up`. For a real deployment, generate random values
# (e.g. `openssl rand -base64 32`) rather than reusing the placeholders below, and keep the
# actual values in 1Password, not in this file or in chat.
# =============================================================================

# PostgreSQL / backend datasource password (used by both the `postgres` and `backend` services in compose.yaml)
DATABASE_PASSWORD=mulaerp123

# Valkey (Redis-compatible cache) password
REDIS_PASSWORD=mulaerp-redis-password

# JWT signing secret for backend auth (jwt.secret in application.yml) — min 32 characters.
# NOTE: with SPRING_PROFILES_ACTIVE=production, the backend refuses to start if this is left at
# this example value or shorter than 32 characters (see ProductionSecretsGuard).
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# =============================================================================
# Optional — sensible defaults apply if unset; only needed to change deployment behaviour.
# =============================================================================

# Frontend API base URL — must include the /api/v1 prefix (frontend/src/lib/api.ts)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Secure flag for the httpOnly MULAERP_AUTH auth cookie (mulaerp.auth.cookie-secure). Keep false
# for local plain-HTTP dev — browsers silently drop Secure cookies over http://. Any environment
# served over HTTPS (test-prod, behind a reverse proxy/load balancer) MUST set this to true.
AUTH_COOKIE_SECURE=false

# White-label product name used in outbound email subjects/bodies. Defaults to "Mula ERP".
BRAND_NAME=Mula ERP

# Comma-separated allowed CORS origins (mulaerp.cors.allowed-origins, SecurityConfig). Defaults to
# the local dev list (localhost:5173/3000/80) plus http://frontend:5173 (the e2e container). Set
# this to your deployment's real origin(s) instead, e.g. https://erp.example.com
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://frontend:5173

# Comma-separated CIDR ranges of reverse proxies trusted to supply a client IP via
# X-Forwarded-For (mulaerp.rate-limit.trusted-proxies, RateLimitConfig). Empty by default — no
# proxy is trusted and rate limiting always keys on the direct socket address, which is the safe/
# correct choice for local dev and any deployment with no reverse proxy in front of the backend.
# Only set this if you put one there (e.g. the nginx service in compose.yaml) — use its
# container/subnet CIDR (e.g. 172.20.0.0/16), never a wildcard.
#RATE_LIMIT_TRUSTED_PROXIES=
